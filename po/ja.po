msgid "Uninstall Complete"
msgstr "アンインストール完了"

#: src/driverpage.cpp:415
msgid ""
"The NVIDIA driver packages were removed. Reboot to use the Nouveau driver."
msgstr ""
"NVIDIA ドライバーパッケージを削除しました。Nouveau ドライバーを使用するには再"
"起動してください。"

