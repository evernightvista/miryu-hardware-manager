msgid "%1 - Installation Log"
msgstr "%1 - 安裝記錄"

#: src/driverpage.cpp:485
msgid "MOK Configuration Log"
msgstr "MOK 設定記錄"

#: src/driverpage.cpp:510
msgid ""
"Secure Boot is enabled. The %1 kernel module must be signed.\n"
"Configure a Machine Owner Key (MOK) now?"
msgstr ""
"安全啟動已啟用，%1 核心模組必須簽章。\n"
