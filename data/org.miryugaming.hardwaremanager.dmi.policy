<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Miryu Gaming</vendor>
  <vendor_url>https://miryu.gaming</vendor_url>

  <action id="org.miryugaming.hardwaremanager.dmi">
    <description>Read memory hardware information</description>
    <description xml:lang="de">Arbeitsspeicherinformationen lesen</description>
    <description xml:lang="fr">Lire les informations de la mémoire</description>
    <description xml:lang="ja">メモリのハードウェア情報を読み取る</description>
    <description xml:lang="ko">메모리 하드웨어 정보 읽기</description>
    <description xml:lang="zh_CN">读取内存硬件信息</description>
    <description xml:lang="zh_TW">讀取記憶體硬體資訊</description>
    <message>Authentication is required to read the memory hardware information.</message>
    <message xml:lang="de">Authentifizierung erforderlich, um Arbeitsspeicherinformationen zu lesen.</message>
    <message xml:lang="fr">Authentification requise pour lire les informations de la mémoire.</message>
    <message xml:lang="ja">メモリのハードウェア情報を読み取るには認証が必要です。</message>
    <message xml:lang="ko">메모리 하드웨어 정보를 읽으려면 인증이 필요합니다.</message>
    <message xml:lang="zh_CN">读取内存硬件信息需要认证。</message>
    <message xml:lang="zh_TW">讀取記憶體硬體資訊需要認證。</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/miryu-hardware-manager-dmi-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
